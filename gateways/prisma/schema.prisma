generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminAdvisoryRequest {
  id                             Int                              @id @default(autoincrement())
  number                         String                           @unique
  client                         String?
  caller                         String
  callerPhone                    String?
  callerEmail                    String?
  callerLocation                 String?
  callerDepartment               String?
  businessCategory               String?
  serviceLine                    String?
  application                    String?
  applicationCategory            String?
  applicationSubCategory         String?
  shortDescription               String?
  description                    String?
  impact                         String?
  urgency                        String?
  priority                       String?
  status                         String                           @default("new")
  assignmentGroup                String?
  primaryResource                String?
  secondaryResources             String?
  createdBy                      String
  isRecurring                    Boolean                          @default(false)
  isReleaseManagement            Boolean                          @default(false)
  eta                            DateTime?
  notes                          String?
  relatedRecords                 String?
  attachments                    String?
  followers                      String?
  internalFollowers              String?
  draftExpiresAt                 DateTime?
  clientPrimaryContact           String?
  billingCode                    String?
  approvedEstimatesHours         Float?
  estimatesDetails               String?
  analysisSummary                String?
  ticketSource                   String?
  resolvedAt                     DateTime?
  resolvedBy                     String?
  closedAt                       DateTime?
  closedBy                       String?
  reopenedAt                     DateTime?
  reopenedBy                     String?
  approvedAt                     DateTime?
  approvedBy                     String?
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime
  callerReportingManager         String?
  AdminAdvisoryRequestActivity   AdminAdvisoryRequestActivity[]
  AdminAdvisoryRequestComment    AdminAdvisoryRequestComment[]
  AdminAdvisoryRequestResolution AdminAdvisoryRequestResolution[]
  AdminAdvisoryRequestTimeEntry  AdminAdvisoryRequestTimeEntry[]
}

model AdminAdvisoryRequestActivity {
  id                   Int                  @id @default(autoincrement())
  advisoryRequestId    Int
  activityType         String
  description          String
  previousValue        String?
  newValue             String?
  performedBy          String
  createdAt            DateTime             @default(now())
  AdminAdvisoryRequest AdminAdvisoryRequest @relation(fields: [advisoryRequestId], references: [id], onDelete: Cascade)
}

model AdminAdvisoryRequestComment {
  id                   Int                  @id @default(autoincrement())
  advisoryRequestId    Int
  subject              String
  message              String
  isInternal           Boolean              @default(false)
  isSelfNote           Boolean              @default(false)
  notifyAssigneesOnly  Boolean              @default(false)
  status               String?
  attachments          String?
  createdBy            String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  AdminAdvisoryRequest AdminAdvisoryRequest @relation(fields: [advisoryRequestId], references: [id], onDelete: Cascade)
}

model AdminAdvisoryRequestResolution {
  id                   Int                  @id @default(autoincrement())
  advisoryRequestId    Int
  application          String?
  category             String?
  subCategory          String?
  customerConfirmation Boolean              @default(false)
  isRecurring          Boolean              @default(false)
  rootCauseIdentified  Boolean              @default(false)
  rootCause            String?
  resolutionCode       String
  resolution           String
  internalNote         String?
  attachments          String?
  createdBy            String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  AdminAdvisoryRequest AdminAdvisoryRequest @relation(fields: [advisoryRequestId], references: [id], onDelete: Cascade)
}

model AdminAdvisoryRequestTimeEntry {
  id                   Int                  @id @default(autoincrement())
  advisoryRequestId    Int
  date                 String
  hours                Int
  minutes              Int
  billingCode          String?
  activityTask         String?
  externalComment      String?
  internalComment      String?
  isNonBillable        Boolean              @default(false)
  attachments          String?
  createdBy            String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  AdminAdvisoryRequest AdminAdvisoryRequest @relation(fields: [advisoryRequestId], references: [id], onDelete: Cascade)
}

model AdminConfiguration {
  id        Int      @id @default(autoincrement())
  data      Json     @default("{}")
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model AdminControls {
  id                      Int      @id @default(autoincrement())
  adminTwoLevel           Boolean  @default(false)
  adminManagerOnly        Boolean  @default(false)
  adminAdditionalApproval Boolean  @default(false)
  adminApprover           String?
  signInStyle             String   @default("new")
  signUpStyle             String   @default("new")
  forgotPasswordStyle     String   @default("new")
  theme                   String   @default("System")
  updatedBy               Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime
}

model AdminDashboard {
  id   String @id @default(cuid())
  name String
  age  Int
}

model AdminHeader {
  id          Int     @id @default(autoincrement())
  ticketType  String
  key         String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)
  app         String
  order       Int
}

model AdminIncident {
  id                      Int                       @id @default(autoincrement())
  number                  String                    @unique
  client                  String?
  caller                  String
  callerPhone             String?
  callerEmail             String?
  callerLocation          String?
  callerDepartment        String?
  additionalContacts      String?
  businessCategory        String?
  serviceLine             String?
  application             String?
  applicationCategory     String?
  applicationSubCategory  String?
  shortDescription        String?
  description             String?
  impact                  String?
  urgency                 String?
  priority                String?
  channel                 String?
  status                  String                    @default("new")
  assignmentGroup         String?
  primaryResource         String?
  secondaryResources      String?
  createdBy               String
  isRecurring             Boolean                   @default(false)
  isMajor                 Boolean                   @default(false)
  isReleaseManagement     Boolean                   @default(false)
  eta                     DateTime?
  notes                   String?
  relatedRecords          String?
  attachments             String?
  followers               String?
  internalFollowers       String?
  draftExpiresAt          DateTime?
  clientPrimaryContact    String?
  billingCode             String?
  approvedEstimatesHours  Float?
  estimatesDetails        String?
  analysisSummary         String?
  ticketSource            String?
  resolvedAt              DateTime?
  resolvedBy              String?
  closedAt                DateTime?
  closedBy                String?
  reopenedAt              DateTime?
  reopenedBy              String?
  approvedAt              DateTime?
  approvedBy              String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  callerReportingManager  String?
  AdminIncidentActivity   AdminIncidentActivity[]
  AdminIncidentComment    AdminIncidentComment[]
  AdminIncidentResolution AdminIncidentResolution[]
  AdminIncidentTimeEntry  AdminIncidentTimeEntry[]
}

model AdminIncidentActivity {
  id            Int           @id @default(autoincrement())
  incidentId    Int
  activityType  String
  description   String
  previousValue String?
  newValue      String?
  performedBy   String
  createdAt     DateTime      @default(now())
  AdminIncident AdminIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model AdminIncidentComment {
  id                  Int           @id @default(autoincrement())
  incidentId          Int
  subject             String
  message             String
  isInternal          Boolean       @default(false)
  isSelfNote          Boolean       @default(false)
  notifyAssigneesOnly Boolean       @default(false)
  status              String?
  attachments         String?
  createdBy           String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime
  AdminIncident       AdminIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model AdminIncidentResolution {
  id                   Int           @id @default(autoincrement())
  incidentId           Int
  application          String?
  category             String?
  subCategory          String?
  customerConfirmation Boolean       @default(false)
  isRecurring          Boolean       @default(false)
  rootCauseIdentified  Boolean       @default(false)
  rootCause            String?
  resolutionCode       String
  resolution           String
  internalNote         String?
  attachments          String?
  createdBy            String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime
  AdminIncident        AdminIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model AdminIncidentTimeEntry {
  id              Int           @id @default(autoincrement())
  incidentId      Int
  date            String
  hours           Int
  minutes         Int
  billingCode     String?
  activityTask    String?
  externalComment String?
  internalComment String?
  isNonBillable   Boolean       @default(false)
  attachments     String?
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  AdminIncident   AdminIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model User {
  id                       Int       @id @default(autoincrement())
  firstName                String
  lastName                 String
  email                    String    @unique
  password                 String
  phone                    String?
  workLocation             String?
  department               String?
  reasonForAccess          String?
  employeeId               String?
  businessUnit             String?
  managerName              String?
  dateOfBirth              String?
  profilePicture           String?
  name                     String
  role                     String    @default("user")
  requestedRole            String?
  status                   String    @default("pending_approval")
  source                   String    @default("signup")
  reviewedBy               Int?
  reviewedAt               DateTime?
  adminNotes               String?
  invitationToken          String?
  invitationExpiry         DateTime?
  mustResetPassword        Boolean   @default(false)
  otp                      String?
  otpExpiresAt             DateTime?
  otpIsUsed                Boolean   @default(false)
  failedLoginAttempts      Int       @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  passwordChangedAt        DateTime?
  isActive                 Boolean   @default(false)
  accessFromDate           DateTime?
  accessToDate             DateTime?
  firstActivationDate      DateTime?
  lastDeactivationDate     DateTime?
  lastActivityAt           DateTime?
  timezone                 String?
  dateFormat               String?
  timeFormat               String?
  language                 String?
  consultantProfileUpdated Boolean   @default(false)
  slaWorkingCalendar       String?
  slaExceptionGroup        String?
  application              String?
  applicationLead          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdBy                String?

  @@map("User")
}

model UserChangeLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  changeType    String
  fieldName     String?
  previousValue String?
  newValue      String?
  changedBy     Int
  changedByName String
  reasonCode    String?
  reasonNotes   String?
  createdAt     DateTime @default(now())

  @@map("UserChangeLog")
}

model LoginLog {
  id         Int       @id @default(autoincrement())
  userId     Int
  loginTime  DateTime  @default(now())
  logoutTime DateTime?
  ipAddress  String?
  device     String?
