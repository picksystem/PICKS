  closedBy                      String?
  reopenedAt                    DateTime?
  reopenedBy                    String?
  approvedAt                    DateTime?
  approvedBy                    String?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime
  callerReportingManager        String?
  AdminServiceRequestActivity   AdminServiceRequestActivity[]
  AdminServiceRequestComment    AdminServiceRequestComment[]
  AdminServiceRequestResolution AdminServiceRequestResolution[]
  AdminServiceRequestTimeEntry  AdminServiceRequestTimeEntry[]
