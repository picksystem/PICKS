model AdminSignIn {
  id   String @id
  name String
  age  Int
}

model AdminTicket {
  id                       Int       @id @default(autoincrement())
  ticketType               String
  number                   String    @unique
  client                   String?
  caller                   String
  callerPhone              String?
  callerEmail              String?
  callerLocation           String?
  callerDepartment         String?
  callerReportingManager   String?
  additionalContacts       String?
  businessCategory         String?
  serviceLine              String?
  application              String?
  applicationCategory      String?
  applicationSubCategory   String?
  shortDescription         String?
  description              String?
  impact                   String?
  urgency                  String?
  priority                 String?
  channel                  String?
  status                   String    @default("new")
  assignmentGroup          String?
  primaryResource          String?
  secondaryResources       String?
  createdBy                String
  isRecurring              Boolean   @default(false)
  isMajor                  Boolean   @default(false)
  notes                    String?
  relatedRecords           String?
  attachments              String?
  draftExpiresAt           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime
  accessRequirements       String?
  actualEndDate            DateTime?
  actualStartDate          DateTime?
  additionalField1         String?
  additionalField2         String?
  additionalField3         String?
  additionalField4         String?
  additionalField5         String?
  additionalField6         String?
  additionalField7         String?
  additionalField8         String?
  additionalField9         String?
  analysisSummary          String?
  approvedAt               DateTime?
  approvedBy               String?
  approvedEstimatesHours   Float?
  backoutPlan              String?
  billingCode              String?
  bugDetails               String?
  cabApprovalRequired      Boolean   @default(false)
  cabId                    String?
  cancellationComment      String?
  cancellationReasonCode   String?
  changeRiskImpactAnalysis String?
  changeType               String?
  clientPrimaryContact     String?
  closedAt                 DateTime?
  closedBy                 String?
  conversionComment        String?
  conversionReasonCode     String?
  currentProcess           String?
  customerConfirmation     Boolean   @default(false)
  estimatesDetails         String?
  eta                      DateTime?
  isRecurringIssue         Boolean   @default(false)
  justificationOfChange    String?
  knownError               String?
  numberOfTimesReopened    Int       @default(0)
  priorityChangeNote       String?
  priorityChangeReasonCode String?
  productBugFix            Boolean   @default(false)
  productBugId             String?
  productOwner             String?
  proposedEndDate          DateTime?
  proposedProcess          String?
  proposedStartDate        DateTime?
  relatedTicket            Boolean   @default(false)
  relatedTicketId          String?
  reopenComment            String?
  reopenReasonCode         String?
  reopenedAt               DateTime?
  reopenedBy               String?
  resolution               String?
  resolutionCode           String?
  resolutionInternalNote   String?
  resolvedAt               DateTime?
  resolvedBy               String?
  rootCause                String?
  rootCauseAnalysis        String?
  rootCauseCode            String?
  rootCauseIdentified      Boolean   @default(false)
  testCompleted            Boolean   @default(false)
  testEvidenceRetained     String?
  testPlan                 String?
  testResults              String?
  ticketConvertedFrom      String?
  userResponse             String?
  vendorName               String?
  vendorTicketReference    String?
  workAround               String?
  workAroundRisk           String?

  @@map("AdminTicket")
}

model AdminTicketType {
  id               Int      @id @default(autoincrement())
  type             String   @unique
  name             String
  displayName      String   @default("")
  displayTag       String   @default("")
  shortDescription String   @default("")
  description      String   @default("")
  prefix           String   @default("")
  isActive         Boolean  @default(true)
  numberLength     Int      @default(7)
  displayOrder     Int      @default(0)
  accessControl    String   @default("")
  layoutConfig     String   @default("")

  @@map("admin_ticket_type")
}

model AdminTicketComment {
  id                  Int      @id @default(autoincrement())
  ticketId            Int
  subject             String
  message             String
  isInternal          Boolean  @default(false)
  isSelfNote          Boolean  @default(false)
  notifyAssigneesOnly Boolean  @default(false)
  status              String?
  attachments         String?
  createdBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime

  @@map("admin_ticket_comment")
}

model AdminTicketTimeEntry {
  id              Int      @id @default(autoincrement())
  ticketId        Int
  date            String
  hours           Int
  minutes         Int
  billingCode     String?
  activityTask    String?
  externalComment String?
  internalComment String?
  isNonBillable   Boolean  @default(false)
  attachments     String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@map("admin_ticket_time_entry")
}

model AdminTicketResolution {
  id                  Int       @id @default(autoincrement())
  ticketId            Int
  application         String?
  category            String?
  subCategory         String?
  customerConfirmation Boolean   @default(false)
  isRecurring         Boolean   @default(false)
  rootCauseIdentified Boolean   @default(false)
  rootCause           String?
  resolutionCode      String
  resolution          String
  internalNote        String?
  attachments         String?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime

  @@map("admin_ticket_resolution")
}

model AdminTicketActivity {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  activityType String
  description  String
  previousValue String?
  newValue      String?
  performedBy  String
  createdAt    DateTime @default(now())

  @@map("admin_ticket_activity")
