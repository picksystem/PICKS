# ================================
# SerivceOps - Environment Variables Template
# ================================
# Copy this file to .env and fill in the actual values
# This file is safe to commit to version control
# Last Updated: 2026-01-29
# ================================

# ============================================
# BACKEND SERVER CONFIGURATION
# ============================================

# Environment
NODE_ENV=production

# Server (Unified API on single port)
PORT=3001
HOST=localhost

# Database
# Note: Special characters in password must be URL-encoded (& becomes %26)
DATABASE_URL=postgresql://postgres.dcuttlufeqdmgcegvjmx:ServiceOps20267013@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_PASSWORD=ServiceOps20267013

# Server-side Session Authentication (cookie sessions, persisted in PostgreSQL)
# Use a long, random secret (32+ bytes of entropy) — it signs the session cookie.
# Rotating this secret invalidates all existing sessions.
SESSION_SECRET=your-super-secret-session-key-change-this-in-production-min-32-chars
# Session lifetime in days for the "stay signed in" cookie
SESSION_TTL_DAYS=7
# PASETO signing key for short-lived signed tokens (e.g. password reset).
# Optional — derived from SESSION_SECRET when unset.
# PASETO_SECRET=

# Session cookie Secure flag.
# By default it follows the connection scheme automatically:
#   https (direct or behind a TLS proxy) -> Secure + SameSite=None
#   plain http                           -> not secure + SameSite=Lax
# Set to true/false only to force it (e.g. dev over http with a browser
# extension, or a misbehaving proxy).
# SESSION_COOKIE_SECURE=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs
ENABLE_CONSOLE_LOGS=true

# CORS
CORS_ORIGIN=http://localhost:1600,http://localhost:1700,https://serviceops.tech,https://www.serviceops.tech

# ============================================
# EMAIL / SMTP CONFIGURATION
# ============================================
# For Gmail: Use an App Password (not regular password)
# 1. Enable 2FA on your Google account
# 2. Generate App Password at: https://myaccount.google.com/apppasswords
# 3. Use the generated 16-character password as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=SerivceOps App <noreply@serviceops.tech>

# ============================================
# API ENDPOINTS (For Reference)
# ============================================
# Admin API: http://localhost:3001/api/admin
# User API: http://localhost:3001/api/user
# Swagger Docs: http://localhost:3001/api/docs

# ============================================
# FRONTEND PORTS (For Reference)
# ============================================
# Admin Apps: http://localhost:1500
# User Apps: http://localhost:1400
